      <div class="cline"><div class="cicon">🏠</div><div><p class="clbl">SDA Provider</p><p class="cval"><a href="{{ content.contact.sda_provider_url }}" target="_blank" style="color:var(--ink);text-decoration:none;">{{ content.contact.sda_provider }}</a></p></div></div>
      <div class="cline"><div class="cicon">🤝</div><div><p class="clbl">SIL Provider</p><p class="cval"><a href="{{ content.contact.sil_provider_url }}" target="_blank" style="color:var(--ink);text-decoration:none;">{{ content.contact.sil_provider }}</a></p></div></div>
      <div style="margin-top:48px;padding:28px 32px;background:var(--sage-pale);border-radius:16px;">
