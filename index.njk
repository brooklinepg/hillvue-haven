<script>
// Nav scroll
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',window.scrollY>60));

// Gallery drag scroll
const gm=document.getElementById('gm'),gp=document.getElementById('gp'),gn=document.getElementById('gn');
let isDragging=false,startX,scrollLeft;
gm.addEventListener('mousedown',e=>{isDragging=true;gm.classList.add('drag');startX=e.pageX-gm.offsetLeft;scrollLeft=gm.scrollLeft;});
document.addEventListener('mouseup',()=>{isDragging=false;gm.classList.remove('drag');});
gm.addEventListener('mousemove',e=>{if(!isDragging)return;e.preventDefault();const x=e.pageX-gm.offsetLeft;gm.scrollLeft=scrollLeft-(x-startX)*1.5;});
gm.addEventListener('scroll',()=>{gp.disabled=gm.scrollLeft<10;gn.disabled=gm.scrollLeft>=gm.scrollWidth-gm.clientWidth-10;});
gn.addEventListener('click',()=>gm.scrollBy({left:400,behavior:'smooth'}));
gp.addEventListener('click',()=>gm.scrollBy({left:-400,behavior:'smooth'}));

// Lightbox
const lb=document.getElementById('lb'),lbi=document.getElementById('lbi');
document.querySelectorAll('.gitem img').forEach(img=>{img.addEventListener('click',()=>{lbi.src=img.src;lb.classList.add('on');});});
document.getElementById('lbx').addEventListener('click',()=>lb.classList.remove('on'));
lb.addEventListener('click',e=>{if(e.target===lb)lb.classList.remove('on');});

// Disclosures toggle
const dt=document.getElementById('discToggle'),db=document.getElementById('discBody');
dt.addEventListener('click',()=>db.classList.toggle('open'));

// Contact form
document.getElementById('cf').addEventListener('submit',async function(e){
  e.preventDefault();
  const btn=document.getElementById('fsub');
  btn.textContent='Sending…';btn.disabled=true;
  try{
    const fd=new FormData(this);
    await fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams(fd).toString()});
    btn.textContent='Sent — we\'ll be in touch!';btn.style.background='var(--sage-deep)';
  }catch{btn.textContent='Something went wrong — email us directly';btn.disabled=false;}
});
</script>
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  window.addEventListener('load', function() {
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on("init", user => {
        if (!user) {
          window.netlifyIdentity.on("login", () => {
            document.location.href = "/admin/";
          });
        }
      });
      if (location.hash && location.hash.includes('invite_token')) {
        window.netlifyIdentity.open();
      }
    }
  });
</script>
