        <p style="font-size:15px;color:var(--ink);font-weight:400;margin-bottom:6px;">Brookline Property Group</p>
        <p style="font-size:13px;color:var(--ink-mid);font-weight:300;line-height:1.7;">{{ content.contact.manager_blurb }}</p>
      </div>
    </div>
    <div class="cform">
      <form id="cf" name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact">
        <div class="frow">
          <div class="fg"><label>Full Name</label><input type="text" name="name" placeholder="Your name" required></div>
          <div class="fg"><label>Phone</label><input type="tel" name="phone" placeholder="Your number"></div>
        </div>
        <div class="fg"><label>Email</label><input type="email" name="email" placeholder="your@email.com" required></div>
        <div class="fg">
          <label>I am a&hellip;</label>
          <select name="role">
            <option value="">Select one</option>
            <option>Prospective Tenant</option>
            <option>Support Coordinator</option>
            <option>Occupational Therapist</option>
            <option>Investor / Fund Inquiry</option>
            <option>Service Provider</option>
            <option>Media / Other</option>
          </select>
        </div>
        <div class="fg"><label>Message</label><textarea name="message" placeholder="Tell us a bit about what you're looking for…"></textarea></div>
        <button type="submit" class="fsubmit" id="fsub">Send Enquiry &rarr;</button>
      </form>
    </div>
  </div>
</section>

